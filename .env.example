# System-Design-OS Environment Variables

# App
PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sd_os?schema=public"

# Redis (Queues, rate limit, caches)
REDIS_URL="redis://localhost:6379"

# Security
JWT_SECRET="super-secret-jwt-signing-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-signing-key-change-in-production"

# External APIs
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
STRIPE_API_KEY=""
STRIPE_WEBHOOK_SECRET=""
CF_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="sd-os-assets"
RESEND_API_KEY=""
POSTHOG_API_KEY=""
