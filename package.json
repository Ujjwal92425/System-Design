{
  "name": "sd-os",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate --filter=@sd-os/db",
    "db:migrate": "turbo run db:migrate --filter=@sd-os/db",
    "db:seed": "turbo run db:seed --filter=@sd-os/db"
  },
  "devDependencies": {
    "turbo": "^2.0.4"
  },
  "packageManager": "npm@11.12.1"
}
